    <string name="voice_help_nav_title">Navigasyon</string>
    <string name="voice_help_nav">• \"Kadıköy\'e git\", \"eve git\", \"işe git\", \"park yerime git\"\n• \"en yakın benzinlik\", \"en yakın kafe\", \"eczane bul\"\n• \"kaç dakika kaldı\", \"ne zaman varırım\", \"sıradaki dönüş ne\"\n• \"otoyolsuz git\", \"ücretsiz yol\", \"rotayı yeniden hesapla\"\n• \"burayı favoriye ekle\", \"evimi buraya ayarla\"\n• \"navigasyonu bitir\"\n• \"bir de eve uğra\", \"oraya git\", \"hayır Ankara değil İzmir\"</string>
    <string name="voice_help_phone_title">Telefon</string>
    <string name="voice_help_phone">• \"Ali\'yi ara\", \"annemi ara\", \"son aradığımı ara\", \"cevapsızı ara\"\n• \"sıfır beş üç altı … ara\"\n• Gelen aramada: \"cevapla\", \"reddet\", \"sessize al\", \"hoparlöre al\"\n• \"son aramalar\"\n• \"Ali\'ye mesaj at\" (ne yazacağını sorar), \"onu ara\"</string>
    <string name="voice_help_msg_title">Mesajlar</string>
    <string name="voice_help_msg">• \"son mesajı oku\", \"kim yazdı\"\n• \"cevap yaz\" (ne yazacağını sorar), \"cevap yaz yoldayım\"\n• Göndermeden önce her zaman \"gönderilsin mi?\" diye sorar</string>
    <string name="voice_help_music_title">Müzik ve ses</string>
    <string name="voice_help_music">• \"müziği aç\", \"durdur\", \"sonraki şarkı\", \"önceki şarkı\", \"ne çalıyor\"\n• \"Tarkan çal\", \"Spotify\'da Sezen Aksu çal\"\n• \"sesi aç\", \"sesi kıs\", \"sesi yüzde elli yap\"</string>
    <string name="voice_help_info_title">Bilgi</string>
    <string name="voice_help_info">• \"hava nasıl\", \"yağmur var mı\", \"saat kaç\"\n• \"pil durumu\", \"hızım kaç\", \"hız sınırı kaç\"\n• \"yarın hava nasıl\", \"akşam hava nasıl\"\n• \"yirmi dakika sonra hatırlat\"</string>
    <string name="voice_help_app_title">Uygulama ve ayar</string>
    <string name="voice_help_app">• \"WhatsApp\'ı aç\", \"haritayı aç\", \"uygulamaları aç\", \"ayarları aç\"\n• \"gece modu\", \"gündüz modu\", \"mil kullan\", \"kilometre kullan\"\n• \"yardım çağır\" SOS geri sayımını başlatır (önce onay ister)\n• \"müziği kıs ve eve git\" (iki komut), \"tekrar et\", \"geri al\", \"sus\"</string>
