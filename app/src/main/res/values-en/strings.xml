    <string name="voice_help_title">What can I say?</string>
    <string name="voice_help_nav_title">Navigation</string>
    <string name="voice_help_nav">• \"Go to Kadıköy\", \"go home\", \"go to work\", \"go to my parking spot\"\n• \"nearest gas station\", \"nearest cafe\", \"find a pharmacy\"\n• \"how long is left\", \"when do I arrive\", \"next turn\"\n• \"avoid highways\", \"avoid tolls\", \"recalculate the route\"\n• \"save this place\", \"set home here\"\n• \"end navigation\"\n(commands are in Turkish)\n• \"bir de eve uğra\", \"oraya git\", \"hayır Ankara değil İzmir\"</string>
    <string name="voice_help_phone_title">Phone</string>
    <string name="voice_help_phone">• \"call Ali\", \"call mum\", \"call the last number\", \"call the missed one\"\n• Digits then \"call\"\n• During a call: \"answer\", \"reject\", \"mute\", \"speaker\"\n• \"recent calls\"\n• \"Ali\'ye mesaj at\" (asks what to write), \"onu ara\"</string>
    <string name="voice_help_msg_title">Messages</string>
    <string name="voice_help_msg">• \"read the last message\", \"who wrote\"\n• \"write a reply\" (asks what to write), or say the text with it\n• It always asks \"send it?\" before sending</string>
    <string name="voice_help_music_title">Music and volume</string>
    <string name="voice_help_music">• \"play music\", \"pause\", \"next song\", \"previous song\", \"what is playing\"\n• \"play Tarkan\", \"play Sezen Aksu on Spotify\"\n• \"volume up\", \"volume down\", \"volume fifty percent\"</string>
    <string name="voice_help_info_title">Information</string>
    <string name="voice_help_info">• \"how is the weather\", \"will it rain\", \"what time is it\"\n• \"battery\", \"how fast am I going\", \"speed limit\"\n• \"yarın hava nasıl\", \"akşam hava nasıl\"\n• \"yirmi dakika sonra hatırlat\"</string>
    <string name="voice_help_app_title">Apps and settings</string>
